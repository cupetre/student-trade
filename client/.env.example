# Copy to .env and fill in. Never commit the real .env file.

# Where the server runs (leave empty in development: Vite proxies /api)
VITE_API_URL=

# Map pictures (tiles). Default: OpenStreetMap's free tile server, fine for
# development and early testing. Before launch, switch to a paid provider or
# self-hosted tiles by changing these two lines (see DESIGN.md, "Maps").
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
