{
    // Used by "Client: Chrome (starts Vite)" in launch.json. Also runnable from
    // Terminal → Run Task. Each task opens its own terminal tab with its logs.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "client: vite dev",
            "type": "npm",
            "script": "dev",
            "path": "client",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": { "regexp": "^x^" },
                "background": {
                    "activeBegins": true,
                    "beginsPattern": "VITE",
                    "endsPattern": "Local:"
                }
            }
        },
        {
            "label": "server: dev",
            "type": "npm",
            "script": "dev",
            "path": "server",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "database: start (docker)",
            "type": "shell",
            "command": "docker compose up -d",
            "problemMatcher": []
        }
    ]
}
