# Copy to .env and fill in. Never commit the real .env file.

# Local dev: matches docker-compose.yml at the repo root as-is.
# Production: point these at the self-hosted Postgres on the VPS instead
# (see server/db/setup-postgres-vps.sh), and set DB_SSL=true once that
# instance has real TLS configured.
DB_HOST=localhost
DB_PORT=5432
DB_USER=studenttrade
DB_PASS=change_me
DB_NAME=studenttrade
DB_SSL=false

JWT_SECRET=change_me_to_a_long_random_string

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
