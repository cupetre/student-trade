# Copy to .env and fill in. Never commit the real .env file.

# Local dev: uses the Docker database published on host port 5433.
# Set DB_PASS and the password in DATABASE_URL to POSTGRES_PASSWORD from
# docker-compose.yml. URL-encode special characters in the URL password.
# Production: point these at the self-hosted Postgres on the VPS instead
# (see server/db/setup-postgres-vps.sh), and set DB_SSL=true once that
# instance has real TLS configured.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=studenttrade
DB_PASS=change_me
DB_NAME=studenttrade
DB_SSL=false

# Prisma uses DATABASE_URL; the pg Pool uses the DB_* variables above.
DATABASE_URL="postgresql://studenttrade:change_me@127.0.0.1:5433/studenttrade?schema=public"

JWT_SECRET=change_me_to_a_long_random_string

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

ALLOWED_EMAIL_DOMAINS=upr.si

# Email verification
# Where the confirmation link points (your frontend)
APP_URL=http://localhost:3131
# A sender address/domain verified in Amazon SES. Leave empty in dev: emails get logged instead of sent
EMAIL_FROM=
# Optional: SES region if different from AWS_REGION
SES_REGION=

# Server (all optional for local development)
# PORT=5151
# Lock CORS and the live-chat socket to your site's address in production, e.g. https://studenttrade.si
# CORS_ORIGIN=
# Set to 1 when running behind nginx or another reverse proxy, so rate limits see real client IPs
# TRUST_PROXY=

# Housing: true = new listings and landlord accounts go live straight away (development).
# Set to false in production so you review them first.
HOUSING_AUTO_APPROVE=false

# Logging (all optional)
# LOG_LEVEL: trace | debug | info | warn | error | silent  (default: debug in development, info in production)
# LOG_LEVEL=debug
# Print every database query in the terminal
# LOG_SQL=true
# Queries slower than this many ms are logged as warnings (default 500)
# SLOW_QUERY_MS=500
# Also write the log as JSON lines to a file (folder is git-ignored)
# LOG_FILE=logs/server.log
